# ==============================================================================
# GaonLab Environment Configuration Template
# Academic Year: 2026-27 | Foundation Stage
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database Configuration (PostgreSQL 16 / Supabase)
# Standard local docker connection:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gaonlab_dev?schema=public"
# Supabase direct connection for migrations (optional when running locally):
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gaonlab_dev?schema=public"

# Database Credentials for Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gaonlab_dev
POSTGRES_PORT=5432

# Client & CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# JWT Secrets (Will be required in Auth Stage; use 32+ char random strings)
JWT_ACCESS_SECRET="replace-with-a-secure-random-secret-for-access-token-min-32-chars"
JWT_REFRESH_SECRET="replace-with-a-secure-random-secret-for-refresh-token-min-32-chars"

# Logging Level (debug | info | warn | error)
LOG_LEVEL=info

# Government Gateway Default Operational Modes (LIVE | CACHED | MOCK | OFF)
GATEWAY_BHASHINI_MODE=MOCK
GATEWAY_DIKSHA_MODE=MOCK
GATEWAY_UDISE_MODE=MOCK
GATEWAY_APAAR_MODE=OFF
GATEWAY_SATS_MODE=OFF

# LLM / Gemini API Configuration
GEMINI_API_KEY=""
GEMINI_MODEL=""
AI_MODEL=""
AI_IMAGE_MODEL=""
VITE_GEMINI_API_KEY=""
VITE_GEMINI_MODEL=""
VITE_AI_MODEL=""
VITE_AI_IMAGE_MODEL=""
